#: src/features/resume/editor/check/issues.ts
msgid "Text this close to the edge can be cut off. Use at least {minimum} pt."
msgstr "അരികിനോട് ചേർന്നുള്ള ടെക്‌സ്‌റ്റ് ഛേദിക്കപ്പെടാം. കുറഞ്ഞത് {minimum} pt എങ്കിലും ഉപയോഗിക്കുക."

#: src/features/resume/editor/check/issues.ts
msgid "Text under {minimum} pt can be misread when a system re-renders it."
msgstr "{minimum} pt-ന് കീഴിലുള്ള ടെക്‌സ്‌റ്റ് ഒരു സിസ്റ്റം റീ-റെൻഡർ ചെയ്യുമ്പോൾ അത് തെറ്റായി വായിക്കാം."

#: src/libs/locale.ts
msgid "Thai"
msgstr "തായ്"

#: src/features/auth/pages/error.tsx
msgid "That provider account is already linked to a different user."
msgstr "ആ ദാതാവിന്റെ അക്കൗണ്ട് ഇതിനകം മറ്റൊരു ഉപയോക്താവുമായി ലിങ്ക് ചെയ്തിട്ടുണ്ട്."

#: src/features/auth/pages/error.tsx
msgid "That provider account uses a different email address than your account."
msgstr "ആ ദാതാവിന്റെ അക്കൗണ്ട് നിങ്ങളുടെ അക്കൗണ്ടിൽ നിന്ന് വ്യത്യസ്തമായ ഇമെയിൽ വിലാസം ഉപയോഗിക്കുന്നു."

#: src/features/settings/ai/providers.tsx
msgid "That provider setup isn't valid. Check the base URL."
msgstr "ആ ദാതാവിൻ്റെ സജ്ജീകരണം സാധുതയുള്ളതല്ല. അടിസ്ഥാന URL പരിശോധിക്കുക."

#: src/features/auth/pages/error.tsx
msgid "That sign-in provider is no longer available on this server."
msgstr "ആ സൈൻ-ഇൻ ദാതാവ് ഈ സെർവറിൽ ഇനി ലഭ്യമല്ല."

#: src/features/resume/share/download-tab.tsx
msgid "The {label} file couldn't be generated. Try again, or download PDF instead."
msgstr "{label} ഫയൽ സൃഷ്ടിക്കാൻ കഴിഞ്ഞില്ല. വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ പകരം PDF ഡൗൺലോഡ് ചെയ്യുക."

#: src/features/auth/pages/error.tsx
msgid "The application that sent you here made an invalid authorization request."
msgstr "നിങ്ങളെ ഇവിടേക്ക് അയച്ച ആപ്ലിക്കേഷൻ അസാധുവായ അംഗീകാര അഭ്യർത്ഥന നടത്തി."

#: src/features/assistant/assistant-panel.tsx
msgid "The assistant isn't set up on this server. Whoever runs it needs to set ENCRYPTION_SECRET. Everything else works without it."
msgstr "ഈ സെർവറിൽ അസിസ്റ്റൻ്റ് സജ്ജീകരിച്ചിട്ടില്ല. അത് പ്രവർത്തിപ്പിക്കുന്നവർ ENCRYPTION_SECRET സജ്ജീകരിക്കേണ്ടതുണ്ട്. മറ്റെല്ലാം അതില്ലാതെ പ്രവർത്തിക്കുന്നു."

#: src/features/assistant/provider-setup.tsx
msgid "The assistant uses your own key. Nothing is sent anywhere until you connect one."
msgstr "അസിസ്റ്റൻ്റ് നിങ്ങളുടെ സ്വന്തം കീ ഉപയോഗിക്കുന്നു. നിങ്ങൾ ഒരെണ്ണം ബന്ധിപ്പിക്കുന്നത് വരെ ഒന്നും എവിടെയും അയക്കില്ല."

#: src/features/settings/ai/web-access.tsx
msgid "The built-in reader remains active."
msgstr "ബിൽറ്റ്-ഇൻ റീഡർ സജീവമായി തുടരുന്നു."

#: src/features/resume/editor/check/writing-tab.tsx
msgid "The checks are mechanical. This asks a language model how a reader might react to your bullets and suggests rewrites. It isn't part of the score."
msgstr "പരിശോധനകൾ മെക്കാനിക്കൽ ആണ്. നിങ്ങളുടെ ലിസ്റ്റ് എൻട്രികളോട് ഒരു വായനക്കാരൻ എങ്ങനെ പ്രതികരിക്കുമെന്ന് ഇത് ഒരു ഭാഷാ മോഡലിനോട് ചോദിക്കുകയും വീണ്ടും എഴുതാൻ നിർദ്ദേശിക്കുകയും ചെയ്യുന്നു. അത് സ്‌കോറിൻ്റെ ഭാഗമല്ല."

#: src/features/resume/editor/write/dates-field.tsx
msgid "The end is before the start."
msgstr "തുടക്കത്തിനു മുമ്പാണ് അവസാനം."

#: src/features/resume/editor/check/check-panel.tsx
msgid "The exported PDF"
msgstr "കയറ്റുമതി ചെയ്ത PDF"

#: src/features/resume/editor/check/check-panel.tsx
msgid "The exported PDF couldn't be checked. Try again."
msgstr "കയറ്റുമതി ചെയ്ത PDF പരിശോധിക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."

#: src/features/documents/new-document-dialog.tsx
msgid "The file couldn't be read as a resume."
msgstr "ഫയൽ ഒരു റെസ്യൂമെ ആയി വായിക്കാൻ കഴിഞ്ഞില്ല."

#: src/features/settings/ai/api-keys.tsx
msgid "the key"
msgstr "താക്കോൽ"

#: src/features/settings/ai/providers.tsx
msgid "The key is encrypted on the server and never shown again. Saving tests the connection."
msgstr "കീ സെർവറിൽ എൻക്രിപ്റ്റ് ചെയ്‌തിരിക്കുന്നു, ഇനി കാണിക്കില്ല. സംരക്ഷിക്കുന്നത് കണക്ഷൻ പരിശോധിക്കുന്നു."

#: src/features/resume/editor/write/improve.tsx
msgid "The line changed since you asked, so it wasn't replaced."
msgstr "നിങ്ങൾ ചോദിച്ചതിന് ശേഷം ലൈൻ മാറിയതിനാൽ അത് മാറ്റിസ്ഥാപിച്ചില്ല."

#: src/features/ats-checker/messages.ts
msgid "The order the text is stored in disagrees badly with the order it reads in."
msgstr "ടെക്സ്റ്റ് സംഭരിച്ചിരിക്കുന്ന ക്രമം അത് വായിക്കുന്ന ക്രമവുമായി വളരെയധികം വ്യത്യാസപ്പെട്ടിരിക്കുന്നു."

#: src/components/layout/not-found-screen.tsx
msgid "The page you're looking for may have been moved or no longer exists."
msgstr "നിങ്ങൾ തിരയുന്ന പേജ് നീക്കിയിരിക്കാം അല്ലെങ്കിൽ നിലവിലില്ലായിരിക്കാം."

#: src/features/resume/editor/check/parser-view.tsx
msgid "The page's PDF couldn't be read. Edit anything to render it again."
msgstr "പേജിൻ്റെ PDF വായിക്കാൻ കഴിഞ്ഞില്ല. അത് വീണ്ടും റെൻഡർ ചെയ്യുന്നതിന് എന്തെങ്കിലും എഡിറ്റ് ചെയ്യുക."

#: src/features/ats-checker/messages.ts
msgid "The pages are pictures, with no text behind them."
msgstr "പേജുകൾ ചിത്രങ്ങളാണ്, പിന്നിൽ ടെക്സ്റ്റൊന്നുമില്ല."

#: src/features/auth/pages/resume-password.tsx
msgid "The password you entered is incorrect"
msgstr "നിങ്ങൾ നൽകിയ പാസ്‌വേഡ് തെറ്റാണ്"

#: src/features/resume/editor/check/job-match.tsx
msgid "The posting asks for “{label}”. If it's true for me, work it into my resume where it fits. Ask me first."
msgstr "ജോലി പോസ്റ്റിംഗ് \"{label}\" ആവശ്യപ്പെടുന്നു. ഇത് എന്നെ സംബന്ധിച്ചിടത്തോളം ശരിയാണെങ്കിൽ, അത് അനുയോജ്യമായിടത്ത് എൻ്റെ റെസ്യൂമെയിൽ ഉൾപ്പെടുത്തുക. ആദ്യം എന്നോട് ചോദിക്ക്."

#: src/features/settings/ai/providers.tsx
msgid "The provider didn't answer."
msgstr "ദാതാവ് ഉത്തരം നൽകിയില്ല."

#: src/features/assistant/provider-setup.tsx
msgid "The provider didn't answer. Check the key and the model."
msgstr "ദാതാവ് ഉത്തരം നൽകിയില്ല. കീയും മോഡലും പരിശോധിക്കുക."

#: src/features/settings/ai/providers.tsx
msgid "The provider didn't answer. Check the key, the model and the base URL."
msgstr "ദാതാവ് ഉത്തരം നൽകിയില്ല. കീ, മോഡൽ, അടിസ്ഥാന URL എന്നിവ പരിശോധിക്കുക."

#: src/features/auth/pages/error.tsx
msgid "The provider didn't share an email address, which is required to sign in."
msgstr "സൈൻ ഇൻ ചെയ്യാൻ ആവശ്യമായ ഇമെയിൽ വിലാസം ദാതാവ് പങ്കിട്ടില്ല."

#: src/features/auth/pages/error.tsx
msgid "The provider rejected this sign-in attempt. Please start again."
msgstr "ദാതാവ് ഈ സൈൻ-ഇൻ ശ്രമം നിരസിച്ചു. ദയവായി വീണ്ടും ആരംഭിക്കുക."

#: src/features/resume/editor/check/writing-tab.tsx
msgid "The provider returned a review that couldn't be read. Try again."
msgstr "വായിക്കാൻ കഴിയാത്ത ഒരു അവലോകനം ദാതാവ് തിരികെ നൽകി. വീണ്ടും ശ്രമിക്കുക."

#: src/features/auth/pages/error.tsx
msgid "The provider's response could not be verified. Please start again."
msgstr "ദാതാവിന്റെ പ്രതികരണം പരിശോധിക്കാനായില്ല. ദയവായി വീണ്ടും ആരംഭിക്കുക."

#: src/features/resume/share/history-tab.tsx
msgid "The resume as it is"
msgstr "റെസ്യൂമെ അതേപടി"

#: src/features/resume/preview/preview.browser.tsx
msgid "The resume preview could not be updated. The last valid preview is still shown."
msgstr "റെസ്യൂമെ പ്രിവ്യൂ അപ്ഡേറ്റ് ചെയ്യാൻ കഴിഞ്ഞില്ല. അവസാനത്തെ സാധുവായ പ്രിവ്യൂ ഇപ്പോഴും കാണിച്ചിരിക്കുന്നു."

#: src/features/resume/editor/check/writing-tab.tsx
msgid "The review couldn't finish. Try again."
msgstr "അവലോകനം പൂർത്തിയാക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."

